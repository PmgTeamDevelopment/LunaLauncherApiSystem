{
  "rewrites": [
    {
      "source": "/",
      "destination": "/hub/index.html"
    },
    {
      "source": "/auth/login",
      "has": [
        {
          "type": "query",
          "key": "get_token"
        }
      ],
      "destination": "/auth/login"
    },
    {
      "source": "/auth/login",
      "destination": "/hub/login.html"
    }
  ]
}
